{
  "schemaVersion": "1.0",
  "gossmsVersion": "test",
  "formats": [
    "text",
    "json",
    "jsonl",
    "csv",
    "tsv",
    "markdown"
  ],
  "exitCodes": [
    {
      "exit": 0,
      "code": "OK",
      "meaning": "Success (output may still be truncated; check truncated)"
    },
    {
      "exit": 1,
      "code": "GENERAL_ERROR",
      "meaning": "Unexpected or internal error"
    },
    {
      "exit": 2,
      "code": "USAGE_ERROR",
      "meaning": "Invalid or unknown arguments"
    },
    {
      "exit": 3,
      "code": "CONNECTION_FAILED",
      "meaning": "Server unreachable, TLS or network error"
    },
    {
      "exit": 4,
      "code": "AUTH_FAILED",
      "meaning": "Login failed or credentials are missing"
    },
    {
      "exit": 5,
      "code": "SQL_ERROR",
      "meaning": "The server returned an error (severity 11 or higher)"
    },
    {
      "exit": 6,
      "code": "TIMEOUT",
      "meaning": "Command or connect timeout"
    },
    {
      "exit": 7,
      "code": "BLOCKED",
      "meaning": "Refused by the safety model or a missing --confirm"
    },
    {
      "exit": 8,
      "code": "NOT_FOUND",
      "meaning": "Profile, database or object does not exist"
    },
    {
      "exit": 9,
      "code": "PERMISSION_DENIED",
      "meaning": "The login lacks the required permission"
    },
    {
      "exit": 10,
      "code": "PARTIAL",
      "meaning": "Some batches succeeded and some failed"
    },
    {
      "exit": 11,
      "code": "UNSUPPORTED",
      "meaning": "The server's version or edition does not support the operation"
    },
    {
      "exit": 130,
      "code": "CANCELLED",
      "meaning": "Ctrl+C or SIGINT"
    }
  ],
  "globals": [
    {
      "name": "--output",
      "short": "-o",
      "type": "enum",
      "enum": [
        "text",
        "json",
        "jsonl",
        "csv",
        "tsv",
        "markdown"
      ],
      "default": "text",
      "negation": null,
      "env": null,
      "help": "Output format"
    },
    {
      "name": "--quiet",
      "short": "-q",
      "type": "bool",
      "enum": [],
      "default": false,
      "negation": "--no-quiet",
      "env": null,
      "help": "Results only, no envelope header"
    },
    {
      "name": "--verbose",
      "short": null,
      "type": "bool",
      "enum": [],
      "default": false,
      "negation": "--no-verbose",
      "env": null,
      "help": "Diagnostic logging to stderr"
    },
    {
      "name": "--no-color",
      "short": null,
      "type": "bool",
      "enum": [],
      "default": false,
      "negation": "--no-no-color",
      "env": null,
      "help": "Never colour the output"
    },
    {
      "name": "--help",
      "short": "-h",
      "type": "bool",
      "enum": [],
      "default": false,
      "negation": "--no-help",
      "env": null,
      "help": "Show help for the command"
    },
    {
      "name": "--max-rows",
      "short": null,
      "type": "int",
      "enum": [],
      "default": 200,
      "negation": null,
      "env": null,
      "help": "Rows kept per result set on stdout; 0 keeps all (in memory: prefer --out-file or -o jsonl for large results)"
    },
    {
      "name": "--max-col-width",
      "short": null,
      "type": "int",
      "enum": [],
      "default": 256,
      "negation": null,
      "env": null,
      "help": "Characters kept per cell in text, markdown, json and jsonl, marked …[+N chars]; 0 keeps all"
    },
    {
      "name": "--max-output-bytes",
      "short": null,
      "type": "int",
      "enum": [],
      "default": 1048576,
      "negation": null,
      "env": null,
      "help": "Cap on stdout in bytes; whole rows are dropped to fit; 0 is no cap"
    },
    {
      "name": "--null-text",
      "short": null,
      "type": "string",
      "enum": [],
      "default": "NULL",
      "negation": null,
      "env": null,
      "help": "How text and markdown show NULL"
    },
    {
      "name": "--headers",
      "short": null,
      "type": "bool",
      "enum": [],
      "default": true,
      "negation": "--no-headers",
      "env": null,
      "help": "Column headers in text, csv and tsv; --no-headers leaves them out"
    },
    {
      "name": "--messages",
      "short": null,
      "type": "bool",
      "enum": [],
      "default": true,
      "negation": "--no-messages",
      "env": null,
      "help": "PRINT and informational messages; --no-messages leaves them out"
    },
    {
      "name": "--out-file",
      "short": null,
      "type": "string",
      "enum": [],
      "default": null,
      "negation": null,
      "env": null,
      "help": "Write every row to this file, its format by extension (.csv .tsv .jsonl .json .md .txt); stdout gets the summary"
    },
    {
      "name": "--force",
      "short": null,
      "type": "bool",
      "enum": [],
      "default": false,
      "negation": "--no-force",
      "env": null,
      "help": "Replace an existing --out-file"
    }
  ],
  "groups": [
    {
      "name": "agent",
      "summary": "Describe gossms to an AI agent"
    },
    {
      "name": "profile",
      "summary": "List, show and test saved connection profiles"
    },
    {
      "name": "db",
      "summary": "List databases and show one database's properties"
    },
    {
      "name": "object",
      "summary": "List, find and describe the objects in the connection's database"
    },
    {
      "name": "query",
      "summary": "Run, parse and classify T-SQL"
    }
  ],
  "commands": [
    {
      "path": "version",
      "summary": "Show the gossms version and the command-line schema version",
      "description": "Prints the build metadata `gossms --version` shows, plus the schema version of this command line's output.",
      "operationClass": "read",
      "arguments": [],
      "options": [],
      "examples": [
        "gossms version",
        "gossms version -o json"
      ]
    },
    {
      "path": "help",
      "summary": "Show help for gossms, a command group or a command",
      "description": "With no argument, lists the command groups. With a group, lists its commands; with a group and a command, shows that command's usage, options and examples, as `<command> --help` does.",
      "operationClass": "read",
      "arguments": [
        {
          "name": "group",
          "help": "A command group, or a depth-1 command such as version",
          "format": null,
          "required": false,
          "repeat": false
        },
        {
          "name": "command",
          "help": "A command in the group",
          "format": null,
          "required": false,
          "repeat": false
        }
      ],
      "options": [],
      "examples": [
        "gossms help",
        "gossms help version"
      ]
    },
    {
      "path": "agent guide",
      "summary": "Print the usage manual for AI agents: rules, call pattern, output contract, exit codes, commands, recipes",
      "description": "What an agent reads before its first call: what gossms is, the rules it must follow, how to call it, the output contract, the exit codes, the command index and recipes. The command index and the group topics are generated from the command tree; the rules and recipes are hand-written. It is printed outside the envelope: markdown by default, plain lines with -o text, and a JSON document of the same sections with -o json; any other format is refused. --brief is the condensed version for a system prompt.",
      "operationClass": "read",
      "arguments": [],
      "options": [
        {
          "name": "--brief",
          "short": null,
          "type": "bool",
          "enum": [],
          "default": false,
          "negation": "--no-brief",
          "env": null,
          "help": "The condensed guide for a system prompt: no recipes, the short form of each section"
        },
        {
          "name": "--topic",
          "short": null,
          "type": "enum",
          "enum": [
            "overview",
            "rules",
            "calling",
            "output",
            "exit-codes",
            "commands",
            "recipes",
            "agent",
            "profile",
            "db",
            "object",
            "query"
          ],
          "default": null,
          "negation": null,
          "env": null,
          "help": "One section, or one command group's commands in full detail"
        }
      ],
      "examples": [
        "gossms agent guide",
        "gossms agent guide --brief",
        "gossms agent guide --topic rules",
        "gossms agent guide --topic object -o json"
      ]
    },
    {
      "path": "agent schema",
      "summary": "Print the JSON catalog of every command, argument, option, exit code and output format",
      "description": "The machine-readable catalog an agent builds tool definitions from and checks a call against: each command's path, summary, operation class, arguments, options (type, enum, typed default, environment variable) and examples, plus the global options, the exit codes and the --output formats. It is JSON whatever --output says (text or json; any other format is refused), printed outside the envelope, and the same document `gossms help -o json` prints. A group, or a group and a command, narrows it to the commands under them.",
      "operationClass": "read",
      "arguments": [
        {
          "name": "group",
          "help": "A command group, or a depth-1 command such as version",
          "format": null,
          "required": false,
          "repeat": false
        },
        {
          "name": "command",
          "help": "A command in the group",
          "format": null,
          "required": false,
          "repeat": false
        }
      ],
      "options": [],
      "examples": [
        "gossms agent schema",
        "gossms agent schema object",
        "gossms agent schema query run"
      ]
    },
    {
      "path": "profile list",
      "summary": "List the saved profiles: server, database, authentication, ceiling, saved password",
      "description": "Lists the named profiles, sorted by name. --all adds the unnamed recent connections, most recent first, named by their generated name, which --profile also accepts. Passwords are never shown, only whether one is saved.",
      "operationClass": "read",
      "arguments": [],
      "options": [
        {
          "name": "--all",
          "short": null,
          "type": "bool",
          "enum": [],
          "default": false,
          "negation": "--no-all",
          "env": null,
          "help": "Also list unnamed recent connections"
        }
      ],
      "examples": [
        "gossms profile list",
        "gossms profile list --all -o json"
      ]
    },
    {
      "path": "profile show",
      "summary": "Show one profile's settings, its operation ceiling and whether its saved password opens",
      "description": null,
      "operationClass": "read",
      "arguments": [
        {
          "name": "name",
          "help": "Profile name, or a recent connection's generated name",
          "format": null,
          "required": true,
          "repeat": false
        }
      ],
      "options": [],
      "examples": [
        "gossms profile show dev",
        "gossms profile show dev -o json"
      ]
    },
    {
      "path": "profile test",
      "summary": "Connect through a profile and report the server version, edition, login and latency",
      "description": "Connects as every command will: the profile, with any connection option given here laid over it. An option that changes the server, port, login, authentication, Entra tenant or client, or weakens TLS does not send the profile's saved password; pass --password-env or --password-stdin then.",
      "operationClass": "read",
      "arguments": [
        {
          "name": "name",
          "help": "Profile name, or a recent connection's generated name",
          "format": null,
          "required": true,
          "repeat": false
        }
      ],
      "options": [
        {
          "name": "--server",
          "short": "-S",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_SERVER",
          "help": "Server: host, host\\instance, host,port (the Connect dialog's syntax)"
        },
        {
          "name": "--port",
          "short": null,
          "type": "int",
          "enum": [],
          "default": null,
          "negation": null,
          "env": null,
          "help": "Port, when --server does not name one"
        },
        {
          "name": "--database",
          "short": "-d",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_DATABASE",
          "help": "Initial database"
        },
        {
          "name": "--auth",
          "short": null,
          "type": "enum",
          "enum": [
            "sql",
            "windows",
            "entra-default",
            "entra-password",
            "entra-msi",
            "entra-sp",
            "entra-azcli",
            "entra-interactive",
            "entra-device-code"
          ],
          "default": null,
          "negation": null,
          "env": "GOSSMS_AUTH",
          "help": "Authentication method; entra-interactive and entra-device-code prompt, so they are refused"
        },
        {
          "name": "--user",
          "short": "-U",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_USER",
          "help": "Login name (sql, windows, entra-password)"
        },
        {
          "name": "--tenant-id",
          "short": null,
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_TENANT_ID",
          "help": "Microsoft Entra tenant ID"
        },
        {
          "name": "--client-id",
          "short": null,
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_CLIENT_ID",
          "help": "Microsoft Entra client ID (service principal, user-assigned managed identity)"
        },
        {
          "name": "--password-env",
          "short": null,
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": null,
          "help": "Name of the environment variable holding the password or client secret"
        },
        {
          "name": "--password-stdin",
          "short": null,
          "type": "bool",
          "enum": [],
          "default": false,
          "negation": "--no-password-stdin",
          "env": null,
          "help": "Read the password or client secret from stdin"
        },
        {
          "name": "--encrypt",
          "short": null,
          "type": "enum",
          "enum": [
            "optional",
            "mandatory",
            "strict"
          ],
          "default": null,
          "negation": null,
          "env": "GOSSMS_ENCRYPT",
          "help": "Connection encryption"
        },
        {
          "name": "--trust-server-certificate",
          "short": null,
          "type": "bool",
          "enum": [],
          "default": false,
          "negation": "--no-trust-server-certificate",
          "env": null,
          "help": "Do not validate the server certificate (development only)"
        },
        {
          "name": "--host-name-in-certificate",
          "short": null,
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": null,
          "help": "Host name the server certificate must name"
        },
        {
          "name": "--application-intent",
          "short": null,
          "type": "enum",
          "enum": [
            "readwrite",
            "readonly"
          ],
          "default": null,
          "negation": null,
          "env": null,
          "help": "readonly routes an availability group listener to a readable secondary"
        },
        {
          "name": "--connect-timeout",
          "short": null,
          "type": "int",
          "enum": [],
          "default": 15,
          "negation": null,
          "env": null,
          "help": "Connect timeout in seconds, 1 to 30"
        }
      ],
      "examples": [
        "gossms profile test dev",
        "gossms profile test dev --database master -o json"
      ]
    },
    {
      "path": "db list",
      "summary": "List databases: state, size, recovery model, compatibility level, collation",
      "description": "One row per database, by name. System databases (master, model, msdb, tempdb and a replication distribution database) are left out unless --include-system; snapshots are listed, with snapshot_of naming their source. Sizes are the allocated file sizes in MB from sys.master_files, so they answer for a database in any state (tempdb's are its startup sizes); they are NULL for a database the login cannot see the files of.",
      "operationClass": "read",
      "arguments": [],
      "options": [
        {
          "name": "--profile",
          "short": "-p",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_PROFILE",
          "help": "Saved connection profile (gossms profile list); connection options override its values"
        },
        {
          "name": "--server",
          "short": "-S",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_SERVER",
          "help": "Server: host, host\\instance, host,port (the Connect dialog's syntax)"
        },
        {
          "name": "--port",
          "short": null,
          "type": "int",
          "enum": [],
          "default": null,
          "negation": null,
          "env": null,
          "help": "Port, when --server does not name one"
        },
        {
          "name": "--database",
          "short": "-d",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_DATABASE",
          "help": "Initial database"
        },
        {
          "name": "--auth",
          "short": null,
          "type": "enum",
          "enum": [
            "sql",
            "windows",
            "entra-default",
            "entra-password",
            "entra-msi",
            "entra-sp",
            "entra-azcli",
            "entra-interactive",
            "entra-device-code"
          ],
          "default": null,
          "negation": null,
          "env": "GOSSMS_AUTH",
          "help": "Authentication method; entra-interactive and entra-device-code prompt, so they are refused"
        },
        {
          "name": "--user",
          "short": "-U",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_USER",
          "help": "Login name (sql, windows, entra-password)"
        },
        {
          "name": "--tenant-id",
          "short": null,
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_TENANT_ID",
          "help": "Microsoft Entra tenant ID"
        },
        {
          "name": "--client-id",
          "short": null,
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_CLIENT_ID",
          "help": "Microsoft Entra client ID (service principal, user-assigned managed identity)"
        },
        {
          "name": "--password-env",
          "short": null,
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": null,
          "help": "Name of the environment variable holding the password or client secret"
        },
        {
          "name": "--password-stdin",
          "short": null,
          "type": "bool",
          "enum": [],
          "default": false,
          "negation": "--no-password-stdin",
          "env": null,
          "help": "Read the password or client secret from stdin"
        },
        {
          "name": "--encrypt",
          "short": null,
          "type": "enum",
          "enum": [
            "optional",
            "mandatory",
            "strict"
          ],
          "default": null,
          "negation": null,
          "env": "GOSSMS_ENCRYPT",
          "help": "Connection encryption"
        },
        {
          "name": "--trust-server-certificate",
          "short": null,
          "type": "bool",
          "enum": [],
          "default": false,
          "negation": "--no-trust-server-certificate",
          "env": null,
          "help": "Do not validate the server certificate (development only)"
        },
        {
          "name": "--host-name-in-certificate",
          "short": null,
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": null,
          "help": "Host name the server certificate must name"
        },
        {
          "name": "--application-intent",
          "short": null,
          "type": "enum",
          "enum": [
            "readwrite",
            "readonly"
          ],
          "default": null,
          "negation": null,
          "env": null,
          "help": "readonly routes an availability group listener to a readable secondary"
        },
        {
          "name": "--connect-timeout",
          "short": null,
          "type": "int",
          "enum": [],
          "default": 15,
          "negation": null,
          "env": null,
          "help": "Connect timeout in seconds, 1 to 30"
        },
        {
          "name": "--include-system",
          "short": null,
          "type": "bool",
          "enum": [],
          "default": false,
          "negation": "--no-include-system",
          "env": null,
          "help": "Also list the system databases"
        },
        {
          "name": "--state",
          "short": null,
          "type": "enum",
          "enum": [
            "online",
            "offline",
            "restoring",
            "recovering",
            "recovery_pending",
            "suspect",
            "emergency",
            "copying",
            "offline_secondary"
          ],
          "default": null,
          "negation": null,
          "env": null,
          "help": "Only databases in this state"
        }
      ],
      "examples": [
        "gossms db list -p dev",
        "gossms db list -p dev --include-system -o json",
        "gossms db list -p dev --state offline"
      ]
    },
    {
      "path": "db info",
      "summary": "Show one database's properties: state, sizes, recovery, collation, owner and options",
      "description": "A record of the Database Properties dialog's facts: the sys.databases fields, the allocated data and log sizes, the space used and free inside the files, and the ALTER DATABASE SET options. A database that is not ONLINE still answers what the server catalog holds; what needs the database itself (space used) is named under warnings instead.",
      "operationClass": "read",
      "arguments": [
        {
          "name": "name",
          "help": "Database name",
          "format": null,
          "required": true,
          "repeat": false
        }
      ],
      "options": [
        {
          "name": "--profile",
          "short": "-p",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_PROFILE",
          "help": "Saved connection profile (gossms profile list); connection options override its values"
        },
        {
          "name": "--server",
          "short": "-S",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_SERVER",
          "help": "Server: host, host\\instance, host,port (the Connect dialog's syntax)"
        },
        {
          "name": "--port",
          "short": null,
          "type": "int",
          "enum": [],
          "default": null,
          "negation": null,
          "env": null,
          "help": "Port, when --server does not name one"
        },
        {
          "name": "--database",
          "short": "-d",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_DATABASE",
          "help": "Initial database"
        },
        {
          "name": "--auth",
          "short": null,
          "type": "enum",
          "enum": [
            "sql",
            "windows",
            "entra-default",
            "entra-password",
            "entra-msi",
            "entra-sp",
            "entra-azcli",
            "entra-interactive",
            "entra-device-code"
          ],
          "default": null,
          "negation": null,
          "env": "GOSSMS_AUTH",
          "help": "Authentication method; entra-interactive and entra-device-code prompt, so they are refused"
        },
        {
          "name": "--user",
          "short": "-U",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_USER",
          "help": "Login name (sql, windows, entra-password)"
        },
        {
          "name": "--tenant-id",
          "short": null,
          "type": "string",
