        },
        {
          "name": "--database",
          "short": "-d",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_DATABASE",
          "help": "Initial database"
        },
        {
          "name": "--auth",
          "short": null,
          "type": "enum",
          "enum": [
            "sql",
