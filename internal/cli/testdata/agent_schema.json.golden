            "entra-default",
            "entra-password",
            "entra-msi",
            "entra-sp",
            "entra-azcli",
            "entra-interactive",
            "entra-device-code"
          ],
          "default": null,
          "negation": null,
          "env": "GOSSMS_AUTH",
          "help": "Authentication method; entra-interactive and entra-device-code prompt, so they are refused"
        },
        {
          "name": "--user",
          "short": "-U",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_USER",
          "help": "Login name (sql, windows, entra-password)"
        },
        {
          "name": "--tenant-id",
          "short": null,
