    {
      "path": "query classify",
      "summary": "Report the operation class (read, write, ddl, admin) of each statement and of the script",
      "description": "Classifies without connecting: one row per statement with its batch, line, class, leading keywords, the object it acts on, why it is above its leader's class, and flags (transaction-control, not-in-transaction, nocount, dynamic-sql, exec, mode-option, output-clause). Anything unrecognised counts as write. With --allow it also applies the check a run would (SET PARSEONLY, NOEXEC and SHOWPLAN_* are refused too) and answers BLOCKED, exit 7, when the script would be refused.",
      "operationClass": "read",
      "arguments": [],
      "options": [
        {
          "name": "--sql",
          "short": "-Q",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": null,
          "help": "Inline T-SQL (fine for a short query)"
        },
        {
          "name": "--file",
          "short": "-i",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": null,
          "help": "T-SQL file; - reads stdin. GO separates batches. UTF-8, or UTF-16 with a byte-order mark"
        },
        {
          "name": "--sql-base64",
          "short": null,
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": null,
          "help": "T-SQL as Base64 of its UTF-8 text, safe from any shell quoting"
        },
        {
          "name": "--allow",
          "short": null,
          "type": "enum",
          "enum": [
            "read",
            "write",
            "ddl",
            "admin"
          ],
          "default": null,
          "negation": null,
          "env": null,
          "help": "Check the script against this class, as a run with --allow would"
        }
      ],
      "examples": [
        "gossms query classify --file fix.sql",
        "gossms query classify --file - --allow write -o json",
        "gossms query classify --sql-base64 VVBEQVRFIGRiby50IFNFVCB4ID0gMQ=="
      ]
    },
    {
      "path": "query run",
      "summary": "Run T-SQL and return its result sets, messages and rows affected",
      "description": "Runs the script on one session, as a query window does: temp tables, SET options and USE carry across its GO batches, and nothing carries across calls. The script is classified first and refused (BLOCKED, exit 7, before connecting) when it is above --allow (default read) or the profile's ceiling. The run stops after the first batch that fails unless --continue-on-error. --transaction rollback runs the whole script in one transaction under SET XACT_ABORT ON and rolls it back, to measure rowsAffected without keeping the change; commit commits it only when every batch succeeded; --max-rows-affected commits only when the rows changed stay at or under the limit. --dry-run classifies and checks without connecting. --param name=value:type runs the script (one batch) through sp_executesql with @name as a typed parameter, so a value is never pasted into the T-SQL; the script is classified as written.",
