      "path": "monitor sessions",
      "summary": "List the server's sessions: login, host, program, database, request, resource use, blocker and wait",
      "description": "One row per session (sys.dm_exec_sessions with its request and connection), by spid, the CLI's own left out; user sessions only unless --include-system. command, wait_type and wait_resource are the running request's, NULL for an idle session. text is the running request's batch, or for an idle session the batch its connection sent last — what opened an idle session's open transaction — its first 512 characters, in the server's auto-parameterized form when the server parameterized it. cpu_ms, reads, writes and logical_reads are the session's totals since login. blocked_by is the session one of its requests waits on — a parallel request's blocked worker counts, and then wait_type, wait_ms and wait_resource are that worker's. --active keeps the sessions running a request; --session-database, --login and --program keep the sessions whose value equals the one given, case-insensitively. Needs VIEW SERVER STATE (VIEW SERVER PERFORMANCE STATE from SQL Server 2022): without it, exit 9 — the server would show only the login's own session.",
      "operationClass": "read",
      "arguments": [],
      "options": [
        {
          "name": "--profile",
          "short": "-p",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_PROFILE",
          "help": "Saved connection profile (gossms profile list); connection options override its values"
        },
        {
          "name": "--server",
          "short": "-S",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_SERVER",
          "help": "Server: host, host\\instance, host,port (the Connect dialog's syntax)"
        },
        {
          "name": "--port",
          "short": null,
          "type": "int",
          "enum": [],
          "default": null,
          "negation": null,
          "env": null,
          "help": "Port, when --server does not name one"
        },
        {
          "name": "--database",
          "short": "-d",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_DATABASE",
          "help": "Initial database"
        },
        {
          "name": "--auth",
          "short": null,
          "type": "enum",
          "enum": [
            "sql",
            "windows",
            "entra-default",
            "entra-password",
            "entra-msi",
            "entra-sp",
            "entra-azcli",
            "entra-interactive",
            "entra-device-code"
          ],
          "default": null,
          "negation": null,
          "env": "GOSSMS_AUTH",
          "help": "Authentication method; entra-interactive and entra-device-code prompt, so they are refused"
        },
        {
          "name": "--user",
          "short": "-U",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_USER",
          "help": "Login name (sql, windows, entra-password)"
        },
        {
          "name": "--tenant-id",
          "short": null,
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_TENANT_ID",
          "help": "Microsoft Entra tenant ID"
        },
        {
          "name": "--client-id",
          "short": null,
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": "GOSSMS_CLIENT_ID",
          "help": "Microsoft Entra client ID (service principal, user-assigned managed identity)"
        },
        {
          "name": "--password-env",
          "short": null,
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": null,
          "help": "Name of the environment variable holding the password or client secret"
        },
        {
          "name": "--password-stdin",
          "short": null,
          "type": "bool",
          "enum": [],
          "default": false,
          "negation": "--no-password-stdin",
          "env": null,
          "help": "Read the password or client secret from stdin"
        },
        {
          "name": "--encrypt",
          "short": null,
          "type": "enum",
          "enum": [
            "optional",
            "mandatory",
            "strict"
          ],
          "default": null,
          "negation": null,
          "env": "GOSSMS_ENCRYPT",
          "help": "Connection encryption"
        },
        {
          "name": "--trust-server-certificate",
          "short": null,
          "type": "bool",
          "enum": [],
          "default": false,
          "negation": "--no-trust-server-certificate",
          "env": null,
          "help": "Do not validate the server certificate (development only)"
        },
        {
          "name": "--host-name-in-certificate",
          "short": null,
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": null,
          "help": "Host name the server certificate must name"
        },
        {
          "name": "--application-intent",
          "short": null,
          "type": "enum",
          "enum": [
            "readwrite",
            "readonly"
          ],
          "default": null,
          "negation": null,
          "env": null,
          "help": "readonly routes an availability group listener to a readable secondary"
        },
        {
          "name": "--connect-timeout",
          "short": null,
          "type": "int",
          "enum": [],
          "default": 15,
          "negation": null,
          "env": null,
          "help": "Connect timeout in seconds, 1 to 30"
        },
        {
          "name": "--active",
          "short": null,
          "type": "bool",
          "enum": [],
          "default": false,
          "negation": "--no-active",
          "env": null,
          "help": "Only sessions running a request"
        },
        {
          "name": "--session-database",
          "short": null,
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": null,
          "help": "Only sessions whose current database is this (case-insensitive); -d is the one the CLI connects to"
        },
        {
          "name": "--login",
          "short": null,
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": null,
          "help": "Only sessions of this login (case-insensitive)"
        },
        {
          "name": "--program",
          "short": null,
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
          "env": null,
          "help": "Only sessions whose program name is this (case-insensitive)"
        },
        {
          "name": "--include-system",
          "short": null,
          "type": "bool",
          "enum": [],
          "default": false,
          "negation": "--no-include-system",
          "env": null,
          "help": "Add the system sessions"
        }
      ],
      "examples": [
        "gossms monitor sessions -p prod-ro",
        "gossms monitor sessions --active --session-database Sales -p prod-ro -o json",
        "gossms monitor sessions --login app_user --program \"Microsoft SQL Server Management Studio\" -p dev"
      ]
    },
    {
      "path": "monitor blocking",
      "summary": "Show the blocking chains: each head blocker and the sessions waiting behind it, as a tree",
      "description": "One row per session in a blocking chain, read from every session, system ones included (the same read as monitor sessions --include-system), in tree order: each chain's head, then the sessions it blocks, depth first, by spid at each level; chains by head spid. head is the chain's head blocker — a session that blocks and is not itself blocked — and depth its distance from it (0 the head). A session blocked by one the read does not show (it ended between the two, or a negative blocker: -2 an orphaned distributed transaction, -4 a latch owner) heads its own chain, blocked_by still naming it. A cycle — a deadlock the monitor has not resolved yet, no head anywhere — is reported once, headed by its lowest spid, cycle 1 on the sessions in the loop. text is the running request's batch, or for an idle session (the usual head blocker, an open transaction left behind) the batch its connection sent last. No blocking is an empty set, status ok. Needs VIEW SERVER STATE (VIEW SERVER PERFORMANCE STATE from SQL Server 2022): without it, exit 9.",
      "operationClass": "read",
      "arguments": [],
      "options": [
        {
          "name": "--profile",
          "short": "-p",
          "type": "string",
          "enum": [],
          "default": null,
          "negation": null,
