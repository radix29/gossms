if @x = 1
    print 'one'
else if @x = 2
    print 'two'
else
    print 'many'
if exists (
    select 1
    from
        sys.objects
    where
        name = 'x'
)
begin
    drop table x;
end
while @i < 3
begin
    set @i = @i + 1;
    if @i = 2
    begin
        continue;
    end
end
begin try
    select 1 / 0
end try
begin catch
    select msg = error_message();
    throw;
end catch
begin transaction;
commit transaction;
if @a = 1
    if @b = 1
        print 'ab'
    else
        print 'a only'
retry:
if @n > 0
    goto retry
