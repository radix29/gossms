# goSSMS — ScanPrefix golden output. Do not hand-edit.
# Regenerate: go test ./internal/tui/sqlparse -run TestScanCompletionPrefixGolden -update-golden
#
# [cursor-sweep] one line per cursor position, in full:
#   <row>,<col> <lexer state> batch=<statement start> quote=<offset|-> | <tokens>
# Tokens are <kind>:<text>@<rune offset>. quote is "-" outside the two
# quoted states, where no caller reads it.
#
# [typing] and [generated] are digests: one hash per script over the same
# per-position stream. Full streams there would run to megabytes. On a
# mismatch, re-run that script through sweepWhileTyping/sweepCursorPositions
# by hand to see what moved.

[cursor-sweep]

== bracket spans go line
script "SELECT [weird\nGO\nname] FROM T"
0,0 normal batch=0 quote=- |
0,1 normal batch=0 quote=- | id:"S"@0
0,2 normal batch=0 quote=- | id:"SE"@0
